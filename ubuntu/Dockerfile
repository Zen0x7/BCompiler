FROM ubuntu:24.04

ARG BUILD_VARIANT=Release
ARG LINK_TYPE=shared
ARG BOOST_VERSION=1.92.0_b1
ARG BOOST_LIBS="--with-json --with-program_options --with-charconv"
ARG SANITIZER=off

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    g++ \
    gcc \
    clang \
    libclang-rt-18-dev \
    cmake \
    ninja-build \
    python3 \
    git \
    wget \
    curl \
    bash \
    ca-certificates \
    wrk \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/build-libcxx-msan.sh /tmp/build-libcxx-msan.sh
RUN SANITIZER=$SANITIZER \
    bash /tmp/build-libcxx-msan.sh

COPY scripts/build-boost.sh /tmp/build-boost.sh
RUN if [ "$SANITIZER" != "off" ]; then C=clang; else C=gcc; fi; \
    BOOST_VERSION=$BOOST_VERSION \
    BUILD_VARIANT=$BUILD_VARIANT \
    LINK_TYPE=$LINK_TYPE \
    BOOST_LIBS=$BOOST_LIBS \
    SANITIZER=$SANITIZER \
    COMPILER=$C \
    bash /tmp/build-boost.sh

COPY scripts/build-gtest.sh /tmp/build-gtest.sh
RUN if [ "$SANITIZER" != "off" ]; then C=clang; else C=gcc; fi; \
    BUILD_VARIANT=$BUILD_VARIANT \
    LINK_TYPE=$LINK_TYPE \
    SANITIZER=$SANITIZER \
    COMPILER=$C \
    bash /tmp/build-gtest.sh

COPY scripts/build-benchmark.sh /tmp/build-benchmark.sh
RUN if [ "$SANITIZER" != "off" ]; then C=clang; else C=gcc; fi; \
    BUILD_VARIANT=$BUILD_VARIANT \
    LINK_TYPE=$LINK_TYPE \
    SANITIZER=$SANITIZER \
    COMPILER=$C \
    bash /tmp/build-benchmark.sh

COPY LICENSE /usr/share/licenses/boost-license/LICENSE

WORKDIR /src
