FROM alpine:3.24.1

ARG BUILD_VARIANT=Release
ARG LINK_TYPE=static
ARG BOOST_VERSION=1.92.0_b1
ARG BOOST_LIBS="--with-json --with-program_options --with-charconv"
ARG SANITIZER=off

RUN apk update && apk add --no-cache \
    alpine-sdk \
    cmake \
    git \
    wget \
    curl \
    bash \
    ca-certificates

COPY scripts/build-boost.sh /tmp/build-boost.sh
RUN BOOST_VERSION=$BOOST_VERSION \
    BUILD_VARIANT=$BUILD_VARIANT \
    LINK_TYPE=$LINK_TYPE \
    BOOST_LIBS=$BOOST_LIBS \
    SANITIZER=$SANITIZER \
    sh /tmp/build-boost.sh

COPY scripts/build-gtest.sh /tmp/build-gtest.sh
RUN BUILD_VARIANT=$BUILD_VARIANT \
    LINK_TYPE=$LINK_TYPE \
    SANITIZER=$SANITIZER \
    sh /tmp/build-gtest.sh

COPY scripts/build-benchmark.sh /tmp/build-benchmark.sh
RUN BUILD_VARIANT=$BUILD_VARIANT \
    LINK_TYPE=$LINK_TYPE \
    SANITIZER=$SANITIZER \
    sh /tmp/build-benchmark.sh

COPY LICENSE /usr/share/licenses/boost-license/LICENSE

WORKDIR /src
